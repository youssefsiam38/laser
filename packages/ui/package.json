{
  "name": "@lasercode/ui",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "The one web app: Electron renderer, browser tab, and PWA. Speaks @lasercode/protocol over WebSocket. React 19 + Vite + assistant-ui + Tailwind v4 (D-15, D-16). Every browser dependency is a devDependency on purpose: the built bundle in dist/ is the artifact, and nothing imports this package's source at runtime (`exports` offers only package.json, which the host resolves to find dist/). As dependencies they were copied into every installer twice, once inside app.asar and again in app.asar.unpacked, for nothing.",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lasercode/protocol": "workspace:*",
    "cmdk": "1.1.1"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.18",
    "@assistant-ui/react-markdown": "0.14.14",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lobehub/icons": "5.18.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/katex": "0.16.7",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "@xyflow/react": "12.11.6",
    "beautiful-mermaid": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "happy-dom": "20.14.0",
    "katex": "0.18.5",
    "lucide-react": "1.41.0",
    "radix-ui": "1.6.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-shiki": "0.11.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "7.1.5"
  }
}
