{
  "name": "@piorbit/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The one web app: Electron renderer, browser tab, and PWA. Speaks @piorbit/protocol over WebSocket. React 19 + Vite + assistant-ui + Tailwind v4 (D-15, D-16).",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.18",
    "@assistant-ui/react-markdown": "0.14.14",
    "@piorbit/protocol": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "radix-ui": "1.6.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-syntax-highlighter": "16.0.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "5.0.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "7.1.5"
  }
}
