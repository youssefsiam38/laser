{
  "name": "@lasercode/pi-extension",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "The one companion Pi extension, loaded into sessions the worker starts. Contains a module per supported community package; modules activate only when their package is present. Allowed to import Pi.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agents-bridge": {
      "types": "./dist/agents-bridge.d.ts",
      "import": "./dist/agents-bridge.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@lasercode/pi-goal": "workspace:*",
    "@lasercode/protocol": "workspace:*",
    "typebox": "1.1.38"
  }
}
