{
  "name": "@lasercode/host",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Supervisor: one worker per project, session catalog, local WebSocket for the UI, relay client, log store. Must not import Pi (it only resolves the worker's entry path).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "laser-host": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lasercode/crypto": "workspace:*",
    "@lasercode/protocol": "workspace:*",
    "@lasercode/ui": "workspace:*",
    "@lasercode/worker": "workspace:*",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
