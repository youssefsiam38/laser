{
  "name": "@lasercode/cli",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "The command-line entry point: host lifecycle, session verbs, pinned-Pi passthrough, doctor. Speaks @lasercode/protocol; never imports Pi.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "laser": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lasercode/crypto": "workspace:*",
    "@lasercode/host": "workspace:*",
    "@lasercode/protocol": "workspace:*",
    "@lasercode/worker": "workspace:*",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
