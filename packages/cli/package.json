{
  "name": "@piorbit/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The `piorbit` command: host lifecycle, session verbs, pinned-Pi passthrough, doctor. Speaks @piorbit/protocol; never imports Pi.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "piorbit": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@piorbit/crypto": "workspace:*",
    "@piorbit/host": "workspace:*",
    "@piorbit/protocol": "workspace:*",
    "@piorbit/worker": "workspace:*",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
