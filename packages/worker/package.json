{
  "name": "@lasercode/worker",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Per-project Pi host. The only package (with pi-extension) allowed to import Pi. Pi version is PINNED here (see AGENTS.md invariant 4).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": "./dist/main.js",
    "./resolve-pi": "./dist/resolve-pi.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "laser-worker": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-search.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@lasercode/pi-extension": "workspace:*",
    "@lasercode/pi-goal": "workspace:*",
    "@lasercode/protocol": "workspace:*",
    "jiti": "2.7.0",
    "pi-mcp-adapter": "2.33.0",
    "pi-web-access": "0.28.0",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.8.0",
    "pi-gpt-transcribe": "github:youssefsiam38/pi-gpt-transcribe#bee9cfffae2ab6badbf4bda727e680e423aea9fd"
  },
  "//optionalDependencies": "The MCP adapter's own keyring bindings, separate from desktop 2.0.0. Direct exact pins make them visible to the packager; each binding's os/cpu fields select the build machine.",
  "optionalDependencies": {
    "@napi-rs/keyring-darwin-arm64": "1.3.0",
    "@napi-rs/keyring-darwin-x64": "1.3.0",
    "@napi-rs/keyring-linux-arm64-gnu": "1.3.0",
    "@napi-rs/keyring-linux-x64-gnu": "1.3.0",
    "@napi-rs/keyring-win32-arm64-msvc": "1.3.0",
    "@napi-rs/keyring-win32-x64-msvc": "1.3.0"
  },
  "devDependencies": { "esbuild": "0.28.1", "@types/proper-lockfile": "4.1.4" }
}
