{
  "name": "@lasercode/relay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Railway byte forwarder. Two sockets per channel id, nothing else. Links NO crypto library (AGENTS.md invariant 7).",
  "bin": {
    "laser-relay": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lasercode/protocol": "workspace:*",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
