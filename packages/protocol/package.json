{
  "name": "@piorbit/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ACP-shaped JSON-RPC messages for piorbit, plus pi/* extras. Imports nothing from Pi.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "3.25.76"
  }
}
