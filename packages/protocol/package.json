{
  "name": "@lasercode/protocol",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "ACP-shaped JSON-RPC messages for the desktop app and its relay, plus pi/* extras. Imports nothing from Pi.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node ../../scripts/identity/check.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "3.25.76"
  }
}
