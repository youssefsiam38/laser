{
  "name": "@piorbit/crypto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Noise IK/KK over 25519_AESGCM_SHA256 (WebCrypto first, @noble fallback), pairing, signed device list. Runs in Node and the browser.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.6",
    "@noble/hashes": "1.8.0"
  }
}
