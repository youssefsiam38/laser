+/** Keep the adapter's fallback ledger, not an assertion of engine state.
+ * An embedding host may fence these mutations during a conversation. In that
+ * case names enter the fallback ledger while remaining registered and active;
+ * a later registration consumes the ledger entry and reconciles activation.
+ */
+export function deactivateDirectTools(
+  toolNames: string[],
+  api: {
+    unregisterTool?: ((name: string) => boolean | void) | undefined;
+    getActiveTools(): string[] | undefined;
+    setActiveTools(names: string[]): void;
+  },
+  fallbackDeactivatedTools: Set<string>,
+): string[] {
+  if (toolNames.length === 0) return [];
+  const unregistered = toolNames.filter(name => api.unregisterTool?.(name) === true);
+  const fallbackNames = toolNames.filter(name => !unregistered.includes(name));
+  const remove = new Set(toolNames);
+  const activeTools = api.getActiveTools();
+  if (!activeTools || activeTools.length === 0) {
+    for (const name of fallbackNames) fallbackDeactivatedTools.add(name);
+    return unregistered;
+  }
+  const nextActiveTools = activeTools.filter(name => !remove.has(name));
+  if (nextActiveTools.length !== activeTools.length) {
+    for (const name of fallbackNames) fallbackDeactivatedTools.add(name);
+    api.setActiveTools(nextActiveTools);
+  }
+  return unregistered;
+}
