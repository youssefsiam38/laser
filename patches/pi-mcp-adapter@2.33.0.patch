@@ -0,0 +1,19 @@
+import type { McpClientIdentity } from "./types.ts";
+
+// Preserve the standalone adapter's historical identities when not embedded.
+const DEFAULT_IDENTITIES = {
+  server: { name: "pi-mcp", version: "1.0.0" },
+  discovery: { name: "pi-mcp-adapter", version: "2.11.0" },
+  probe: { name: "pi-mcp-probe", version: "2.1.2" },
+};
+
+/** Project only MCP Implementation fields; OAuth defaults never enter clientInfo. */
+export function resolveClientInfo(identity: McpClientIdentity | undefined, purpose: keyof typeof DEFAULT_IDENTITIES, serverName?: string) {
+  if (purpose === "server" && serverName === undefined) throw new Error("MCP server name is required for a server identity");
+  const value = identity ?? DEFAULT_IDENTITIES[purpose];
+  return {
+    name: purpose === "server" ? `${value.name}-${serverName}` : value.name,
+    ...(identity?.title !== undefined ? { title: identity.title } : {}),
+    version: value.version,
+  };
+}
