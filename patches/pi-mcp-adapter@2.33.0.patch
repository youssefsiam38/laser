@@ -0,0 +1,51 @@
+import type { McpExtensionState } from "./state.ts";
+import { updateServerMetadata } from "./init.ts";
+import { isServerDisabled } from "./types.ts";
+
+export function managementRefusal(params: Record<string, unknown>) {
+  const forbidden = ["connect", "install", "enable", "disable", "remove", "disconnect", "enable_server", "disable_server", "url", "target"]
+    .some(key => params[key] !== undefined) || (params.action !== undefined && params.action !== "ui-messages");
+  return forbidden ? { content: [{ type: "text" as const, text: "Server connections and sign-in are managed by the person in Settings → MCP servers. You can discover and call tools from enabled servers." }],
+    isError: true, details: { error: "person_managed_servers" } } : undefined;
+}
+
+/** Embedding-owned refusal only; never grants connection or configuration authority. */
+export async function prepareAuthorizedCatalog(state: McpExtensionState): Promise<void> {
+  state.authorizationFailures ??= new Map();
+  state.authorizationToolNames ??= new Map();
+  state.catalogFailures ??= new Map();
+  await Promise.all(Object.keys(state.config.mcpServers).map(async server => {
+    if (isServerDisabled(state.config.mcpServers[server])) { state.toolMetadata.delete(server); return; }
+    const refusal = await state.authorization?.(server);
+    if (refusal) {
+      state.authorizationFailures!.set(server, refusal);
+      const tools = state.toolMetadata.get(server);
+      if (tools) state.authorizationToolNames!.set(server, tools.flatMap(tool => [tool.name, tool.originalName]));
+      state.toolMetadata.delete(server);
+      state.serverInstructions.delete(server);
+      return;
+    }
+    state.authorizationFailures!.delete(server);
+    const connection = state.manager.getConnection(server);
+    if (connection?.status === "connected") {
+      try {
+        const result = await state.manager.refreshTools(server, connection, undefined, "use");
+        if (result === "superseded" || result === "refresh-timeout") throw new Error("refresh unavailable");
+        updateServerMetadata(state, server);
+        state.catalogFailures!.delete(server);
+      } catch {
+        state.toolMetadata.delete(server);
+        state.catalogFailures!.set(server, `Tool information for "${server}" could not be refreshed. Try again.`);
+      }
+    } else if (!(state.catalogExpiresAt?.get(server)! > Date.now())) {
+      state.toolMetadata.delete(server);
+    }
+  }));
+}
+
+export function authorizationRefusal(state: McpExtensionState, server?: string, tool?: string) {
+  const match = server ?? [...state.authorizationToolNames ?? []].find(([, names]) => tool !== undefined && names.includes(tool))?.[0];
+  const message = match ? state.authorizationFailures?.get(match) : undefined;
+  return message ? { content: [{ type: "text" as const, text: message }], isError: true,
+    details: { error: "needs_auth", server: match, message } } : undefined;
+}
