+/** Status/instructions remain available even when discovery has no matches. */
+export function discoveryGuidance(state: McpExtensionState, server?: string, matches: readonly { server: string }[] = []): string[] {
+  const noMatches = matches.length === 0;
+  const addressed = new Set(matches.map(match => match.server));
+  const names = server ? [server] : Object.keys(state.config.mcpServers)
+    .filter(name => !isServerDisabled(state.config.mcpServers[name]))
+    .filter(name => noMatches || addressed.has(name)).sort().slice(0, 12);
+  return names.flatMap(name => {
+    if (!state.config.mcpServers[name]) return [`Server "${name}" not found. Use mcp({}) to see available servers.`];
+    const connection = state.manager.getConnection(name);
+    const messages: string[] = [];
+    if (state.manager.isConnecting(name)) messages.push(`Server "${name}" is still connecting; retry in a moment.`);
+    else if (connection?.status === "needs-auth") messages.push(`Server "${name}" needs auth. Use mcp({ action: "auth-start", server: "${name}" }).`);
+    else if (connection?.status !== "connected") {
+      const cached = state.toolMetadata.get(name);
+      const stateText = cached === undefined ? "is configured but not connected"
+        : cached.length ? "has cached tools, not connected" : "has no cached tools (not connected)";
+      messages.push(`Server "${name}" ${stateText}. Use mcp({ connect: "${name}" }) to connect.`);
+    }
+    const instructions = state.serverInstructions.get(name);
+    if (instructions && noMatches) messages.push(`Server "${name}" instructions: ${truncateAtWord(instructions, INSTRUCTIONS_PREVIEW_LENGTH)}\nUse mcp({ instructions: "${name}" }) for full instructions.`);
+    return messages;
+  });
+}
