{
  "name": "laser",
  "private": true,
  "version": "0.3.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "identity:generate": "node scripts/identity/generate.mjs",
    "identity:check": "node scripts/identity/check.mjs",
    "sandbox": "node scripts/sandbox.mjs",
    "verify": "pnpm -r build && pnpm -r typecheck && pnpm -r test && pnpm test:release",
    "test:release": "node --test scripts/release/test/*.test.mjs",
    "verify:install": "bash scripts/release/verify-install.sh",
    "version:set": "bash scripts/release/set-version.sh"
  },
  "dependencies": {
    "@lasercode/cli": "workspace:*",
    "@lasercode/host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
